# Shared Rails stack for the Imentore monorepo.
#
# Each engine keeps its own Gemfile so it can still be worked on in isolation,
# but the Rails/runtime dependency versions must resolve as one application.

gem "rails", "4.0.13"

gem "jquery-rails", "3.1.3"
gem "jquery-datatables-rails", "3.3.0"
gem "jquery-ui-rails", "5.0.5"
gem "responders", "1.1.2"
gem "x-editable-rails"
gem "rails-observers"
gem "bootstrap-sass", "~> 3.3.5.1"
gem "bootstrap-sass-extras", "0.0.6"
gem "bootstrap-datepicker-rails", "1.3.1.1"
gem "turbolinks", "2.5.3"
gem "sass", "3.4.25"
gem "sass-rails", "~> 5.0.1"
gem "coffee-rails", "~> 4.1.0"
gem "coffee-script-source"
gem "font-awesome-rails", "4.3.0.0"
gem "uglifier", "2.7.2"
gem "execjs", "2.6.0"
gem "therubyracer", "0.12.2"

gem "hpricot"
gem "delocalize", "1.0.0"
gem "i18n_alchemy"
gem "tinymce-rails", "4.3.3"
gem "mysql2", "0.3.20"
gem "will_paginate", "3.0.7"
gem "will_paginate-bootstrap", "0.2.5"

gem "inherited_resources", "1.6.0"
gem "devise", "3.5.1"
gem "devise-encryptable"
gem "simple_form", "3.1.0"
gem "slim-rails", "3.0.1"
gem "country_select", "0.0.1"
gem "liquid", "3.0.3"
gem "correios-frete", "1.6.1"
gem "carrierwave", "0.7.0"
gem "mini_magick", "4.2.7"
gem "paperclip",
    git: "https://github.com/thoughtbot/paperclip.git",
    ref: "37589f9b0c869c8df5be1ee4d83e14fb353a7dff"
gem "state_machine", "1.2.0"
gem "ancestry", "2.1.0"
gem "paranoia", "2.1.5"

gem "moip-ruby", "0.1.4", git: "https://github.com/brenoperucchi/moip-ruby.git"
gem "pag_seguro", "0.1.18", git: "https://github.com/brenoperucchi/pagseguro.git"
gem "pagamento_digital", git: "https://github.com/brenoperucchi/pagamento_digital.git"

gem "httparty", "0.13.7"
gem "nokogiri", "1.6.7.2"
gem "mail", "2.6.3"
gem "mime-types", "2.99"

# Re-enable after fixing ruby-plesk.gemspec; current Bundler rejects its TODO description.
# gem "ruby-plesk", git: "https://github.com/brenoperucchi/ruby-plesk.git"

group :development do
  gem "thin"
  gem "rb-readline"
  gem "quiet_assets", "1.1.0"
  gem "bullet", "5.0.0"
  gem "better_errors", "2.1.1"
  gem "binding_of_caller", "0.7.2"
  gem "meta_request", "0.4.3"
end

group :production do
  gem "unicorn"
end

group :development, :test do
  gem "pry", "0.10.3"
  gem "pry-remote", "0.1.7"
  gem "pry-byebug", "3.3.0"
  gem "pry-meta"

  gem "rspec-rails", "3.4.1"
  gem "test-unit"
  gem "guard-rspec", require: false
  gem "guard-cucumber", "0.7.5", require: false
  gem "ffi", "1.9.25"
  gem "cucumber-rails", "1.3.0", require: false
  gem "shoulda-matchers", "3.1.1"
  gem "database_cleaner", "1.5.1"
  gem "factory_girl_rails", "4.5.0"
  gem "capybara", "2.6.2"
  gem "capybara-webkit", "1.8.0"
  gem "launchy", "2.4.3"
  gem "fabrication"
  gem "sqlite3", "~> 1.3.13"
  gem "rb-fsevent" if RUBY_PLATFORM =~ /darwin/i
end

group :deployment do
  gem "capistrano", "3.2.1"
  gem "capistrano-rails", "~> 1.1.1"
  gem "capistrano-bundler", "~> 1.1.3"
  gem "capistrano-rbenv", "~> 2.0.2"
end
